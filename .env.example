# ==============================================================================
# SEED2MARKET - Environment Variables Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Authentication & Database
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Python ML Inference Microservice (FastAPI + PyTorch)
PYTHON_ML_SERVICE_URL=http://127.0.0.1:8000

# Open-Meteo Weather API (Free open-source endpoint, no API key required)
NEXT_PUBLIC_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Open Government Data (OGD) / AGMARKNET API (Optional - falls back to labeled demo data if unconfigured)
DATA_GOV_IN_API_KEY=your_ogd_api_key_here

# Demonstration Mode Flag (true enables resilient local state & Pune demo dataset fallback if Supabase credentials are empty)
NEXT_PUBLIC_DEMO_MODE=true
